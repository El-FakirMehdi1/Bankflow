
POST http://localhost:8081/rpc
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "method": "getBalance",
  "params": {
    "accountNumber": "BA1001"
  },
  "id": "1"
}
### Test 2 - Transfer 1000 DH
POST http://localhost:8081/rpc
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "method": "transferMoney",
  "params": {
    "senderAccount": "BA1001",
    "receiverAccount": "BA1002",
    "amount": 1000
  },
  "id": "2"
}
